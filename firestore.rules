rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // proUnlocked/proUnlockedAt are only ever set by the verifyRazorpayPayment
      // Cloud Function (via the Admin SDK, which bypasses these rules) after it
      // verifies a real payment — clients must not be able to grant themselves Pro.
      allow create: if request.auth != null && request.auth.uid == uid
        && !('proUnlocked' in request.resource.data)
        && !('proUnlockedAt' in request.resource.data);

      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['proUnlocked', 'proUnlockedAt']);

      // A user's own itemized expense log — fully owned by them, no server-only fields.
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Payment records are written only by the Cloud Function (Admin SDK); clients
    // never read or write them directly.
    match /payments/{paymentId} {
      allow read, write: if false;
    }
  }
}
