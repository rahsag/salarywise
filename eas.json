{
  "cli": {
    "version": ">= 18.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "credentialsSource": "local"
      }
    },
    "apk": {
      "extends": "production",
      "android": {
        "credentialsSource": "local",
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
